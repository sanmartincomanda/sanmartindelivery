{
  "name": "comanda-digital",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:store-access": "node scripts/testStoreAccess.mjs && node scripts/testNativeAuthLoading.mjs",
    "test:box-images": "node scripts/testStoreBoxImages.mjs",
    "catalog:optimize-box-images": "node scripts/optimizeBoxCatalogImages.mjs",
    "test:box-announcement": "node scripts/testBoxAnnouncement.mjs",
    "test:box-announcement-rules": "node scripts/testBoxAnnouncementRules.mjs",
    "test:box-sales": "node scripts/testStoreBoxSales.mjs",
    "test:box-sales-rules": "node scripts/testStoreBoxSalesRules.mjs",
    "test:box-sales-ui": "node scripts/testStoreBoxSalesUI.mjs",
    "test:retail-interactions": "node scripts/testRetailInteractions.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/preserveLegacyChunkAliases.mjs && node scripts/writeWebRelease.mjs",
    "build:android:web": "vite build --mode android",
    "build:ios:web": "vite build --mode ios",
    "android:sync": "npm run build:android:web && npx cap sync android",
    "ios:sync": "npm run build:ios:web && npx cap sync ios && node scripts/prepareIos.mjs",
    "test:ios-config": "node scripts/testIosConfiguration.mjs",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview",
    "test:first-order-rewards": "node scripts/testFirstOrderRewards.mjs",
    "test:admin-reports": "node scripts/testAdminReports.mjs",
    "test:order-traceability": "node scripts/testOrderTraceability.mjs",
    "test:store-order-source": "node scripts/testStoreOrderSource.mjs",
    "test:google-auth": "node scripts/testGoogleSignIn.mjs",
    "test:apple-auth": "node scripts/testAppleSignIn.mjs",
    "test:promotion-share": "node scripts/testPromotionShare.mjs",
    "test:store-product-promotions": "node scripts/testStoreProductPromotions.mjs",
    "test:store-categories": "node scripts/testStoreCategoryStructure.mjs",
    "test:store-editorial": "node scripts/testStorefrontEditorial.mjs",
    "test:retail-home": "node scripts/testRetailHomeNavigation.mjs",
    "test:web-release": "node --test scripts/testWebRelease.mjs",
    "test:manual-route": "node scripts/testManualRouteOrders.mjs && node scripts/testRouteSanMartin.mjs",
    "test:route-zones": "node scripts/testRouteZones.mjs",
    "test:route-rules": "node scripts/testRoutePauseRules.mjs && node scripts/testRouteSettingsApi.mjs",
    "test:sicar-customer-fields": "node scripts/testSicarCustomerFields.mjs",
    "test:store-reward-status": "node scripts/testStoreRewardStatus.mjs",
    "test:store-reward-reservations": "node scripts/testStoreRewardReservations.mjs",
    "test:kitchen-staff": "node scripts/testKitchenStaff.mjs",
    "sicar:bridge": "node scripts/sicarBridgeServer.mjs",
    "sicar:publish:combos": "node scripts/publishSicarStoreCombos.mjs",
    "sicar:sync:all-sold-4m": "node scripts/syncSicarAllSold4m.mjs",
    "sicar:update:prices": "node scripts/updateSicarPrices.mjs",
    "store:publish:casero-combos-popup": "node scripts/publishCaseroCombosPopup.mjs",
    "store:seed:first-order-reward": "node scripts/seedFirstOrderRewardCampaign.mjs",
    "crm:publish": "node scripts/publishCrmAnalytics.mjs",
    "catalog:migrate:images": "node scripts/migrateCatalogImagesToStorage.mjs",
    "auth:bootstrap": "node scripts/bootstrapAuthUsers.mjs",
    "auth:branches:bootstrap": "node scripts/bootstrapBranchAdmins.mjs",
    "auth:drivers:sync": "node scripts/syncDriverAuthCredentials.mjs",
    "auth:cleanup:store-customers": "node scripts/cleanupLegacyStoreCustomers.mjs",
    "clients:sync-directory": "node scripts/syncClientDirectory.mjs",
    "firebase:login": "npx firebase-tools login",
    "firebase:use": "npx firebase-tools use comanda-digital-ac1ec",
    "firebase:deploy:rules": "npx firebase-tools deploy --only database,storage",
    "firebase:deploy:database": "npx firebase-tools deploy --only database",
    "firebase:deploy:storage": "npx firebase-tools deploy --only storage",
    "store:hosting:deploy": "npm run build && npx firebase-tools deploy --only hosting --project tiendavirtual-2ced1"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "8.4.2",
    "firebase": "^12.6.0",
    "firebase-admin": "^14.1.0",
    "leaflet": "1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "sharp": "0.32.6",
    "vite": "^5.4.19"
  }
}
