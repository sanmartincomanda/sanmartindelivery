# Google Maps JavaScript API key for address search and the draggable delivery map.
VITE_GOOGLE_MAPS_API_KEY=

# Public origin containing the Netlify Poket functions. This is not a secret.
VITE_POKET_API_ORIGIN=https://tienda.sanmartinsr.com

# Configure these as encrypted environment variables in Netlify, never in this file.
POKET_ACCESS_TOKEN=
POKET_MERCHANT_ID=
POKET_TERMINAL_ID=
POKET_CALLBACK_URL=https://tienda.sanmartinsr.com/?poket=return
POKET_PAYLINK_TTL_MINUTES=1440
POKET_WEBHOOK_USERNAME=
POKET_WEBHOOK_PASSWORD=
FIREBASE_DATABASE_URL=https://comanda-digital-ac1ec-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON=
